# Puerto publicado en la maquina host.
API_GATEWAY_PORT=3000

# Al ejecutar el gateway localmente con npm.
AUTH_SERVICE_URL=http://localhost:8083

# Al ejecutar el gateway en Docker y el servicio de auth en la maquina host.
# Si auth corre en la misma red Docker, usa por ejemplo http://auth-service:8083.
DOCKER_AUTH_SERVICE_URL=http://host.docker.internal:8083

# Endpoint de Laravel que valida el Bearer (GET, 200 = token valido).
AUTH_VALIDATE_PATH=/api/auth/me
# Segundos de cache de una validacion exitosa (ms). Un logout la invalida.
TOKEN_CACHE_TTL_MS=30000

# --- Seguridad ---
# Origenes permitidos por CORS, separados por coma. Vacio = CORS deshabilitado.
CORS_ORIGINS=
# Numero de proxies delante del gateway (nginx, balanceador). Vacio = ninguno.
TRUST_PROXY=
# Peticiones por ventana y por IP (general / login, register y forgot-password).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
# Tamano maximo de body aceptado (bytes).
MAX_BODY_BYTES=1048576
