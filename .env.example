# Puerto publicado en la maquina host.
API_GATEWAY_PORT=3000

# Al ejecutar el gateway localmente con npm.
AUTH_SERVICE_URL=http://localhost:8083

# Al ejecutar el gateway en Docker y el servicio de auth en la maquina host.
# Si auth corre en la misma red Docker, usa por ejemplo http://auth-service:8083.
DOCKER_AUTH_SERVICE_URL=http://host.docker.internal:8083

# Endpoint de Laravel con el usuario y su rol (solo se consulta en rutas con roleRules).
AUTH_VALIDATE_PATH=/api/auth/me
# Cache (ms) de esa consulta de usuario/rol.
TOKEN_CACHE_TTL_MS=30000

# --- Seguridad ---
# Origenes permitidos por CORS, separados por coma. Vacio = CORS deshabilitado.
CORS_ORIGINS=
# Numero de proxies delante del gateway (nginx, balanceador). Vacio = ninguno.
TRUST_PROXY=
# Peticiones por ventana y por IP (general / login, register y forgot-password).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
# Tamano maximo de body aceptado (bytes).
MAX_BODY_BYTES=1048576

# --- JWT ---
# Clave PUBLICA con la que auth (Passport) firma los JWT (RS256): storage/oauth-public.key
# de auth-api. PEM en una sola linea con \n, o AUTH_JWT_PUBLIC_KEY_PATH con la ruta a un archivo.
# Es publica: no da acceso a nada, solo permite verificar firmas.
AUTH_JWT_PUBLIC_KEY=
# AUTH_JWT_PUBLIC_KEY_PATH=
# Opcional: si se define, el claim aud (id del cliente OAuth) debe coincidir.
AUTH_JWT_AUDIENCE=

# --- Billing ---
# Si se define, se registra el servicio: /billing/* -> <URL>/api/*
BILLING_SERVICE_URL=
# Idem pero al ejecutar el gateway en Docker (servicio en el host).
DOCKER_BILLING_SERVICE_URL=
