    {
      "name": "Gateway",
      "item": [
        {
          "name": "Health (agregado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Comprueba tambien los servicios aguas abajo. 503 si alguno cae."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok o 503 degraded', () => pm.expect([200,503]).to.include(pm.response.code));",
                  "pm.test('Lista servicios', () => pm.expect(pm.response.json().services).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health live",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health/live",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health",
                "live"
              ]
            },
            "auth": {
              "type": "noauth"
            },
